{
  "name": "Restaurant Management System (RMS)",
  "version": "3.4.0",
  "private": true,
  "description": "Robust, scalable frontend application that delivers an intuitive and accessible interface for restaurant operations management, enabling real-time data visualization and seamless user interactions.",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "lint": "oxlint src --fix && eslint \"src/**/*.html\" --fix",
    "lint:check": "oxlint src && eslint \"src/**/*.html\"",
    "lint:ts": "oxlint src",
    "lint:templates": "eslint \"src/**/*.html\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "contract:shapes": "node scripts/check-request-shapes.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:admin": "lhci autorun --config=./.lighthouserc.admin.json",
    "design:check": "node scripts/check-design-tokens.mjs",
    "verify:ui": "npm run lint:check && npm run format:check && npm run design:check && npm run test"
  },
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/platform-browser": "^21.2.11",
    "@angular/router": "^21.2.11",
    "@angular/service-worker": "^21.2.11",
    "@primeuix/themes": "^2.0.2",
    "@stomp/stompjs": "^7.3.0",
    "@tailwindcss/postcss": "^4.1.14",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.0",
    "jwt-decode": "^4.0.0",
    "marked": "^12.0.2",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.14",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "@angular/platform-browser-dynamic": "^21.2.11",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/dompurify": "^3.0.5",
    "angular-eslint": "21.3.1",
    "eslint": "^9.38.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "postcss": "^8.5.3",
    "typescript": "~5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ],
    "printWidth": 100,
    "singleQuote": true
  }
}

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "associations": [
    {
      "files": ["src/**/*.html"],
      "language": "angular-html"
    }
  ],
  "ignorePatterns": ["build/**", "dist/**", "coverage/**", "node_modules/**", ".angular/**"]
}
